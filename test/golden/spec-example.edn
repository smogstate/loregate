#:plan{:id
       "sha256:dedacfb9ca3e3a16c9026fc78b944fefcdff1d8ae27279cbace1be7a665fc75b",
       :sql
       "WITH \"invoice\" AS (SELECT CASE WHEN CAST(? AS BOOLEAN) THEN \"invoice\".\"biz/amount\" END AS \"biz/amount\", \"invoice\".\"biz/client-id\" AS \"biz/client-id\", \"invoice\".\"biz/due-date\" AS \"biz/due-date\", \"invoice\".\"biz/invoice-status\" AS \"biz/invoice-status\" FROM (SELECT CAST(\"amount\" AS DECIMAL(38,2)) AS \"biz/amount\", CAST(\"client_id\" AS VARCHAR) AS \"biz/client-id\", CAST(\"due_date\" AS DATE) AS \"biz/due-date\", CASE WHEN \"status\" IS NULL THEN NULL WHEN \"status\" = CAST(? AS VARCHAR) THEN CAST(? AS VARCHAR) WHEN \"status\" = CAST(? AS VARCHAR) THEN CAST(? AS VARCHAR) ELSE error('loregate:schema-mismatch') END AS \"biz/invoice-status\" FROM \"src_invoice\") AS \"invoice\"), \"client\" AS (SELECT \"client\".\"biz/client-id\" AS \"biz/client-id\", \"client\".\"biz/client-name\" AS \"biz/client-name\" FROM (SELECT CAST(\"id\" AS VARCHAR) AS \"biz/client-id\", CAST(\"name\" AS VARCHAR) AS \"biz/client-name\", CAST(\"region\" AS VARCHAR) AS \"biz/region\" FROM \"src_client\") AS \"client\" WHERE (list_contains(CAST(? AS VARCHAR[]), CAST(? AS VARCHAR)) OR (\"client\".\"biz/region\" = CAST(? AS VARCHAR)))) SELECT CAST(\"client\".\"biz/client-name\" AS VARCHAR) AS \"biz/client-name\", CAST(sum(\"invoice\".\"biz/amount\") FILTER (WHERE (\"invoice\".\"biz/invoice-status\" = CAST(? AS VARCHAR))) AS DECIMAL(38,2)) AS \"biz/unpaid-total\", CAST(count(*) AS BIGINT) AS \"n\" FROM \"invoice\" LEFT JOIN \"client\" ON \"invoice\".\"biz/client-id\" = \"client\".\"biz/client-id\" WHERE ((\"invoice\".\"biz/invoice-status\" = CAST(? AS VARCHAR)) AND (date_diff('day', CAST(\"invoice\".\"biz/due-date\" AS DATE), CAST(CAST(? AS DATE) AS DATE)) > CAST(? AS BIGINT))) GROUP BY 1 HAVING (sum(\"invoice\".\"biz/amount\") FILTER (WHERE (\"invoice\".\"biz/invoice-status\" = CAST(? AS VARCHAR))) > CAST(? AS DECIMAL(38,6))) ORDER BY 2 DESC NULLS LAST, 1 ASC NULLS LAST, 3 ASC NULLS LAST LIMIT 50",
