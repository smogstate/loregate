#:plan{:id
       "sha256:f1959f4bcdb9395d869e4065b88b1e8040b6b764b6c1b514c3ce0ca720fd51f7",
       :sql
       "WITH \"invoice\" AS (SELECT CAST(\"amount\" AS DECIMAL(38,2)) AS \"biz/amount\", CAST(\"client_id\" AS VARCHAR) AS \"biz/client-id\", CAST(\"due_date\" AS DATE) AS \"biz/due-date\", CASE WHEN \"status\" IS NULL THEN NULL WHEN \"status\" = CAST(? AS VARCHAR) THEN CAST(? AS VARCHAR) WHEN \"status\" = CAST(? AS VARCHAR) THEN CAST(? AS VARCHAR) ELSE error('loregate:schema-mismatch') END AS \"biz/invoice-status\" FROM \"src_invoice\"), \"client\" AS (SELECT CAST(\"id\" AS VARCHAR) AS \"biz/client-id\", CAST(\"name\" AS VARCHAR) AS \"biz/client-name\" FROM \"src_client\") SELECT CAST(\"client\".\"biz/client-name\" AS VARCHAR) AS \"biz/client-name\", CAST(sum(\"invoice\".\"biz/amount\") FILTER (WHERE (\"invoice\".\"biz/invoice-status\" = CAST(? AS VARCHAR))) AS DECIMAL(38,2)) AS \"biz/unpaid-total\", CAST(count(*) AS BIGINT) AS \"n\" FROM \"invoice\" LEFT JOIN \"client\" ON \"invoice\".\"biz/client-id\" = \"client\".\"biz/client-id\" WHERE ((\"invoice\".\"biz/invoice-status\" = CAST(? AS VARCHAR)) AND (date_diff('day', CAST(\"invoice\".\"biz/due-date\" AS DATE), CAST(CAST(? AS DATE) AS DATE)) > CAST(? AS BIGINT))) GROUP BY 1 HAVING (sum(\"invoice\".\"biz/amount\") FILTER (WHERE (\"invoice\".\"biz/invoice-status\" = CAST(? AS VARCHAR))) > CAST(? AS DECIMAL(38,6))) ORDER BY 2 DESC NULLS LAST, 1 ASC NULLS LAST, 3 ASC NULLS LAST LIMIT 50",
       :sql-params
       [{:value "PAID"}
        {:value :biz.status/paid}
        {:value "UNPAID"}
        {:value :biz.status/unpaid}
        {:value :biz.status/unpaid}
        {:value :biz.status/unpaid}
        {:clock :today}
        {:param :min-days}
        {:value :biz.status/unpaid}
        {:value 0}],
       :sources
